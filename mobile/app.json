{
  "expo": {
    "name": "Threadia",
    "slug": "threadia",
    "version": "1.0.4",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/logo.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.threadia.mobile",
      "buildNumber": "2",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Threadia needs photo access to convert your images into cross-stitch patterns.",
        "NSCameraUsageDescription": "Threadia needs camera access to take photos for cross-stitch patterns.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.threadia.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      "expo-apple-authentication"
    ],
    "extra": {
      "eas": {
        "projectId": "0706b1e7-0747-43f6-abc5-4cadd1da3663"
      }
    },
    "owner": "burotring"
  }
}
