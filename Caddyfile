api.threadia.app {
	reverse_proxy backend:5001
}

threadia.app, www.threadia.app {
	root * /srv/static
	encode gzip zstd
	# Clean URLs: /privacy → /privacy.html so the App Store review
	# team gets a 200 on the bare path. The route block forces the
	# rewrite to run before file_server; literal paths (with an
	# extension or matching an existing file) are served unchanged.
	route {
		try_files {path} {path}.html
		file_server
	}
}
